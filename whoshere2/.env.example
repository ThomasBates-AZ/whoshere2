# Settings for Who's Here?.
#   Portainer: paste these into the stack's Environment variables (Advanced mode). No file needed.
#   Synology Container Manager / docker compose: copy this file to .env next to docker-compose.yml.
# Never commit your real .env. If a password contains a $ sign, wrap the value in single quotes.

# Networking. "bridge" (default) serves the board on HOST_PORT.
# "host" shares the server's own network so "Add my phone" sees each phone's real address;
# use it on Synology, where bridge mode hides those addresses. In host mode the board is on PORT.
NETWORK_MODE=bridge
HOST_PORT=8085
# Port the app listens on: inside the container in bridge mode, on the server itself in host mode.
PORT=8080

# --- UniFi -----------------------------------------------------------------
# Console address, e.g. https://192.168.1.1 (UniFi OS) or https://controller:8443 (old self-hosted)
UNIFI_URL=
# Recommended: API key from a View Only local account (UniFi Network 9+)
UNIFI_API_KEY=
# Fallback when there's no API key: a read-only local account
UNIFI_USERNAME=
UNIFI_PASSWORD=
# Site name or short code
UNIFI_SITE=default
# UniFi consoles use a self-signed certificate
UNIFI_VERIFY_SSL=false

# --- Web -------------------------------------------------------------------
# Required to manage people and devices
ADMIN_PASSWORD=
# Optional: require a password to see the board and history
VIEW_PASSWORD=
SITE_TITLE=Who's Here?
TZ=America/Phoenix

# --- Staff self-registration (/register) -----------------------------------
# Let staff add their own phone from the staff Wi-Fi
SELF_REGISTER=false
# Optional code staff must type on the page
REGISTER_CODE=
# Override the network name shown in the "turn off private address" steps.
# Leave empty to use the names in WIFI_NETWORKS.
STAFF_WIFI_NAME=

# --- Wi-Fi networks ------------------------------------------------------------
# Your staff Wi-Fi networks, comma-separated, exactly as they're named in UniFi.
# When set: the Devices list only shows phones on these networks (guest devices are hidden),
# and "Add my phone" only accepts phones on them and names them in its instructions.
# Staff are tracked on any network either way. Leave empty to treat all networks the same.
# Example: WIFI_NETWORKS=Staff WiFi, Office WiFi
WIFI_NETWORKS=
# Show which Wi-Fi network each person and device is on (board, Devices, History). true or false.
SHOW_WIFI_NETWORK=true
# If a reverse proxy sits in front of the app, its IP address here
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Behaviour ---------------------------------------------------------------
POLL_INTERVAL_SECONDS=60
# Minutes a phone can be missing before its owner counts as gone
DEPARTURE_GRACE_MINUTES=10
# Seconds without a good UniFi answer before the board says "Can't confirm"
STALE_AFTER_SECONDS=180
HISTORY_DAYS=365
# Forget unassigned (guest) devices not seen for this many days
DEVICE_RETENTION_DAYS=30

# --- Google Chat (optional) ------------------------------------------------------
# Turns on /whoshere, /allclear and /history in Google Chat. Setup: README, "Google Chat".
# The Pub/Sub subscription the app reads from:
GOOGLE_CHAT_SUBSCRIPTION=
# e.g. GOOGLE_CHAT_SUBSCRIPTION=projects/example-whoshere/subscriptions/whoshere-chat
# Only these people (emails) or domains (@example.org) may use it. Empty = anyone the app is shared with.
GOOGLE_CHAT_ALLOWED=
# In shared spaces, answer only the person who asked (true) or the whole space (false).
GOOGLE_CHAT_PRIVATE_REPLIES=true
# Link to the board, added to Chat replies. Use an address staff can open, e.g. http://whoshere.local:8085
BOARD_URL=
# Optional icon for the top of Chat answers: a public https link to a PNG (e.g. docs/chat-avatar.png
# uploaded to your website). Leave empty for no icon.
CHAT_AVATAR_URL=

# --- Apple Watch app (optional) ---------------------------------------------------
# Notifications go through Apple's push service. Setup: README, "Apple Watch".
# From the Apple Developer site: the key's 10-character Key ID and your Team ID.
# Upload the .p8 key itself on the Apple Watch admin page.
APNS_KEY_ID=
APNS_TEAM_ID=
# The watch app's bundle ID, e.g. org.example.whoshere.watchkitapp
APNS_BUNDLE_ID=
# true for a build installed from Xcode; false for TestFlight or App Store builds
APNS_SANDBOX=true
# When to tap the watch: clear (it's all clear to arm), stale (the board can't confirm), both, or none
WATCH_PUSH=clear
# Optional: if set, the watch app (and any other script) needs this token to use /api/status and /api/push.
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
API_TOKEN=
